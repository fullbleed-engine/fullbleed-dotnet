<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>FullBleed.DotNet</AssemblyName>
    <RootNamespace>FullBleed.DotNet</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <EnablePackageValidation>true</EnablePackageValidation>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <PackageId>FullBleed.DotNet</PackageId>
    <Version>0.2.5</Version>
    <Authors>Fullbleed contributors</Authors>
    <Description>Generate PDFs from HTML/CSS in C# with an in-process Rust engine. Build invoices and reports, or compose documents with C# components, LINQ and reusable styles. Includes native runtimes, PNG previews, diagnostics and compiled VDP; no browser or system PDF stack required.</Description>
    <PackageTags>pdf;html;css;html-to-pdf;invoice;report;document-generation;components;vdp;printing;fullbleed</PackageTags>
    <PackageReleaseNotes>Clearer HTML/CSS-to-PDF package metadata and runnable quickstarts for both HTML/CSS and C# components. Rendering APIs and the Fullbleed 2.5.40 engine are unchanged.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/fullbleed-engine/fullbleed-dotnet</RepositoryUrl>
    <PackageProjectUrl>https://docs.fullbleed.dev/</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../THIRD_PARTY_NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="../../native-provenance.json" Pack="true" PackagePath="/" />
    <None Include="../../licenses/native/**/*" Pack="true" PackagePath="licenses/native/" />
    <None Include="../../runtimes/**/native/*" Pack="true" PackagePath="runtimes/%(RecursiveDir)%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FullBleed.DotNet.Tests" />
  </ItemGroup>
</Project>
